@page "/"
@attribute [Authorize]
@inject HttpClient Http
@inject CmsApiService Api
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Class="mt-4" Color="Color.Primary" Variant="Variant.Filled">
    <MudTabPanel Text="📊 Thống kê tổng hợp" Icon="@Icons.Material.Filled.BarChart">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <MudText Typo="Typo.h5" Style="font-weight: 700; color: #fff;">📊 Thống kê khách</MudText>
            <MudMenu StartIcon="@Icons.Material.Filled.FilterList" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" 
                     Label="@(_selectedDays == 1 ? "Hôm nay" : _selectedDays == 7 ? "7 ngày qua" : "30 ngày qua")" 
                     Color="Color.Info" Variant="Variant.Outlined" Dense="true" Style="border-radius: 8px; background: rgba(255,255,255,0.05);">
                <MudMenuItem OnClick="@(() => OnPeriodChanged(1))">Hôm nay</MudMenuItem>
                <MudMenuItem OnClick="@(() => OnPeriodChanged(7))">7 ngày qua</MudMenuItem>
                <MudMenuItem OnClick="@(() => OnPeriodChanged(30))">30 ngày qua</MudMenuItem>
            </MudMenu>
        </MudStack>

        <MudGrid Class="mb-6">
            @* Thẻ Tổng lượng khách *@
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-6 rounded-xl shadow-lg" Elevation="4" Style="background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%); color: white; height: 160px; display: flex; flex-direction: column; justify-content: center;">
                    <MudText Typo="Typo.subtitle1" Style="opacity: 0.7; font-weight: 500;">Tổng lượng khách (@(_selectedDays) ngày qua)</MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Baseline" Spacing="2" Class="mt-2">
                        <MudText Typo="Typo.h2" Style="font-weight: 800; color: #3b82f6;">@_totalRecentVisitors.ToString("N0")</MudText>
                        <MudText Typo="Typo.h6" Style="color: #fbbf24; font-weight: 700;">↑ @(_growthPercent)%</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>

            @* Thẻ Giờ cao điểm *@
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-6 rounded-xl shadow-lg" Elevation="4" Style="background: #1a1a1a; color: white; height: 160px; display: flex; flex-direction: column; justify-content: center; align-items: center; border: 1px solid rgba(255,255,255,0.05);">
                    <MudText Typo="Typo.subtitle1" Style="opacity: 0.7; width: 100%;">Giờ cao điểm</MudText>
                    <MudStack AlignItems="AlignItems.Center" Spacing="1" Class="mt-1">
                        <MudIcon Icon="@Icons.Material.Filled.AccessTime" Style="font-size: 2.5rem; color: #fbbf24;" />
                        <MudText Typo="Typo.h4" Style="font-weight: 800;">@_peakHourStr</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>

            @* Thẻ Ngày đông nhất *@
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-6 rounded-xl shadow-lg" Elevation="4" Style="background: #1a1a1a; color: white; height: 160px; display: flex; flex-direction: column; justify-content: center; align-items: center; border: 1px solid rgba(255,255,255,0.05);">
                    <MudText Typo="Typo.subtitle1" Style="opacity: 0.7; width: 100%;">Ngày đông nhất</MudText>
                    <MudStack AlignItems="AlignItems.Center" Spacing="1" Class="mt-1">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Style="font-size: 2.5rem; color: #a5b4fc;" />
                        <MudText Typo="Typo.h4" Style="font-weight: 800;">@_peakDayStr</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>

            @* Biểu đồ theo giờ *@
            <MudItem xs="12" md="7">
                <MudPaper Class="pa-6 rounded-xl shadow-lg" Elevation="4" Style="background: linear-gradient(135deg, #0d0d0d 0%, #1a1a1a 100%); color: white;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.Timeline" Color="Color.Info" />
                        <MudText Typo="Typo.h6" Style="font-weight: 700;">Lưu lượng khách theo giờ</MudText>
                    </MudStack>
                    @if (_peakHourSeries.Count > 0)
                    {
                        <MudChart ChartType="ChartType.Line" ChartSeries="@_peakHourSeries" 
                                  ChartLabels="@_peakHourLabels" Width="100%" Height="320px" 
                                  ChartOptions="@_peakChartOptions" />
                    }
                    <div class="d-flex justify-center mt-2">
                        <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.4);">
                            Dữ liệu tương tác thực tế trong @_selectedDays ngày qua
                        </MudText>
                    </div>
                </MudPaper>
            </MudItem>

            @* Biểu đồ theo Thứ *@
            <MudItem xs="12" md="5">
                <MudPaper Class="pa-6 rounded-xl shadow-lg" Elevation="4" Style="background: linear-gradient(135deg, #0d0d0d 0%, #1a1a1a 100%); color: white;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.BarChart" Color="Color.Warning" />
                        <MudText Typo="Typo.h6" Style="font-weight: 700;">Mật độ khách theo Thứ</MudText>
                    </MudStack>
                    @if (_peakDaySeries.Count > 0)
                    {
                        <MudChart ChartType="ChartType.Bar" ChartSeries="@_peakDaySeries" 
                                  ChartLabels="@_peakDayLabels" Width="100%" Height="320px" ChartOptions="@_barChartOptions" />
                    }
                </MudPaper>
            </MudItem>

            @* Các chỉ số cũ *@
            <AuthorizeView Roles="admin" Context="authContext">
                <Authorized>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-4 rounded-lg" Elevation="2" Style="border-left: 4px solid #4caf50; background: #1a1a1a; color: white;">
                            <MudText Typo="Typo.h4" Color="Color.Success">@((_totalRevenue + _totalMerchantRevenue).ToString("N0"))</MudText>
                            <MudText Typo="Typo.subtitle2" Style="opacity: 0.8;">Tổng doanh thu (VND)</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-4 rounded-lg" Elevation="2" Style="border-left: 4px solid #2196f3; background: #1a1a1a; color: white;">
                            <MudText Typo="Typo.h4" Color="Color.Info">@_activeDevices.Count(x => x.IsOnline)</MudText>
                            <MudText Typo="Typo.subtitle2" Style="opacity: 0.8;">Đang Online</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-4 rounded-lg" Elevation="2" Style="border-left: 4px solid #ff9800; background: #1a1a1a; color: white;">
                            <MudText Typo="Typo.h4" Color="Color.Warning">@_uniqueDevicesCount</MudText>
                            <MudText Typo="Typo.subtitle2" Style="opacity: 0.8;">Thiết bị duy nhất</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-4 rounded-lg" Elevation="2" Style="background: #1a1a1a; color: white;">
                            <MudText Typo="Typo.h4" Color="Color.Primary">@_totalQr</MudText>
                            <MudText Typo="Typo.subtitle2" Style="opacity: 0.8;">Tổng lượt quét QR</MudText>
                        </MudPaper>
                    </MudItem>
                </Authorized>
            </AuthorizeView>

            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 rounded-lg" Elevation="2" Style="background: #161b22; color: #c9d1d9;">
                    <MudText Typo="Typo.h6" Class="mb-3">🏆 Top POI được nghe nhiều nhất</MudText>
                    <MudTable Items="_topPois" Hover="true" Dense="true" Elevation="0" Class="transparent-table">
                        <HeaderContent>
                            <MudTh>POI</MudTh><MudTh>Lượt</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Key</MudTd>
                            <MudTd><MudChip T="string" Size="Size.Small" Color="Color.Primary">@context.Value</MudChip></MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 rounded-lg" Elevation="2" Style="background: #161b22; color: #c9d1d9;">
                    <MudText Typo="Typo.h6" Class="mb-3">🌐 Phân bổ ngôn ngữ</MudText>
                    <MudTable Items="_langStats" Hover="true" Dense="true" Elevation="0" Class="transparent-table">
                        <HeaderContent>
                            <MudTh>Ngôn ngữ</MudTh><MudTh>Tỉ lệ</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@GetLangFlag(context.Key)</MudTd>
                            <MudTd>
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    <MudProgressLinear Value="@GetPercent(context.Value)" Color="Color.Info" Class="flex-grow-1" />
                                    <MudText Typo="Typo.caption">@GetPercent(context.Value).ToString("F1")%</MudText>
                                </MudStack>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            </MudItem>

            <style>
                .transparent-table { background: transparent !important; }
                .transparent-table text { color: #c9d1d9 !important; }
                .transparent-table th { color: #8b949e !important; }
            </style>
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.h6">📍 POI Hotspots (Độ phổ biến địa điểm)</MudText>
                    <MudText Typo="Typo.caption" Style="color:#fb923c">Vùng càng sáng = POI càng được quét nhiều</MudText>
                </MudStack>
                <div id="poi-heatmap" style="height:450px; width:100%; border-radius:12px; border: 1px solid rgba(255,255,255,0.1);"></div>
            </MudPaper>
        </MudItem>

        @if (_isAdmin)
        {
            <MudItem xs="12">
                <MudPaper Class="pa-6" Elevation="2">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                        <MudText Typo="Typo.h6">📈 Thống kê doanh thu (7 ngày gần nhất)</MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Success" 
                                   StartIcon="@Icons.Custom.FileFormats.FileExcel"
                                   OnClick="ExportToExcel">Xuất Excel (.csv)</MudButton>
                    </MudStack>
                    
                    @if (_chartSeries.Count > 0)
                    {
                        <MudChart ChartType="ChartType.Line" ChartSeries="@_chartSeries" 
                                   @bind-SelectedIndex="_chartIndex" ChartLabels="@_chartLabels" 
                                   Width="100%" Height="350px" ChartOptions="@_chartOptions" />
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info">Chưa đủ dữ liệu để vẽ biểu đồ doanh thu</MudAlert>
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudText Typo="Typo.h6" Class="mb-3">📅 Doanh thu theo tháng</MudText>
                    <MudTable Items="_monthlyRevenue" Hover="true" Dense="true">
                        <HeaderContent>
                            <MudTh>Tháng/Năm</MudTh><MudTh>Doanh thu (VND)</MudTh><MudTh>Lượt thanh toán</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Month</MudTd>
                            <MudTd>@context.Amount.ToString("N0")</MudTd>
                            <MudTd>@context.Count</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudText Typo="Typo.h6" Class="mb-3">📍 Doanh thu theo POI</MudText>
                    <MudTable Items="_poiRevenue" Hover="true" Dense="true">
                        <HeaderContent>
                            <MudTh>POI</MudTh><MudTh>Doanh thu (VND)</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Name</MudTd>
                            <MudTd>@context.Amount.ToString("N0")</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            </MudItem>
        }

        <AuthorizeView Roles="admin">
            <MudItem xs="12">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudText Typo="Typo.h6" Class="mb-3">🗺️ Tuyến di chuyển người dùng</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Success" Class="mb-2" Style="font-weight: 600;">
                        📍 Dữ liệu lộ trình chính xác thời gian thực (High Precision GPS)
                    </MudText>
                    <div id="tracemap" style="height:400px; width:100%; border-radius:8px;"></div>
                </MudPaper>
            </MudItem>
        </AuthorizeView>

            <MudItem xs="12">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudText Typo="Typo.h6" Class="mb-3">🕒 Sự kiện gần nhất (Kiểm tra Log)</MudText>
                    <MudTable Items="_unified.Take(10)" Hover="true" Dense="true">
                        <HeaderContent>
                            <MudTh>Thời gian</MudTh>
                            <MudTh>Hành động</MudTh>
                            <MudTh>POI</MudTh>
                            <MudTh>Thiết bị</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Timestamp.ToLocalTime().ToString("HH:mm:ss dd/MM")</MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Color="@GetActionColor(context.EventType)">@context.EventType</MudChip>
                            </MudTd>
                            <MudTd>@context.PoiName</MudTd>
                            <MudTd>@context.Device</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    <MudTabPanel Text="📱 Thiết bị đang chạy" Icon="@Icons.Material.Filled.PhonelinkRing">
        <MudTable Items="_activeDevices" Hover="true" FixedHeader="true" Height="600px" Filter="new Func<DeviceSession,bool>(FilterFunc)">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Danh sách thiết bị khách hàng</MudText>
                <MudSpacer />
                <MudText Typo="Typo.caption" Style="color:#4caf50" Class="mr-4">● @_activeDevices.Count(x => x.IsOnline) khách đang online (30s gần nhất)</MudText>
                <MudTextField @bind-Value="_searchString" Placeholder="Tìm theo ID thiết bị..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Trạng thái</MudTh>
                <MudTh>ID Thiết bị</MudTh>
                <MudTh>Hoạt động cuối</MudTh>
                <MudTh>Lượt quét</MudTh>
                <MudTh>POI hiện tại</MudTh>
                <MudTh>Thao tác</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <div class="d-flex align-center">
                        <div class="status-dot @(context.IsOnline ? "online" : "offline")"></div>
                        <MudText Typo="Typo.body2" Class="ml-2">@(context.IsOnline ? "Online" : "Offline")</MudText>
                    </div>
                </MudTd>
                <MudTd Style="font-family: monospace; font-weight: bold;">@context.DeviceId</MudTd>
                <MudTd>@context.LastActive.ToLocalTime().ToString("HH:mm:ss dd/MM")</MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Color="Color.Info">@context.ScanCount lượt</MudChip></MudTd>
                <MudTd>@context.LastPoiName</MudTd>
                <MudTd>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" 
                               OnClick="@(() => Nav.NavigateTo($"/history?device={context.DeviceId}"))">
                        Xem lịch sử
                    </MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>Không tìm thấy thiết bị nào khớp với yêu cầu</MudText>
            </NoRecordsContent>
        </MudTable>

        <style>
            .status-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
            .status-dot.online { background-color: #4caf50; box-shadow: 0 0 10px #4caf50; }
            .status-dot.offline { background-color: #9e9e9e; }
        </style>
    </MudTabPanel>
</MudTabs>

@code {
    [Inject] NavigationManager Nav { get; set; } = default!;

    class UnifiedEvent
    {
        public DateTime Timestamp { get; set; }
        public string EventType { get; set; } = "";
        public string PoiId { get; set; } = "";
        public string PoiName { get; set; } = "";
        public string Language { get; set; } = "";
        public int Duration { get; set; }
        public string Device { get; set; } = "";
        public double Lat { get; set; }
        public double Lng { get; set; }
        public double Amount { get; set; }
    }

    // Dashboard Filters & New Stats
    private int _selectedDays = 7;
    private int _totalRecentVisitors = 0;
    private string _peakHourStr = "--:--";
    private string _peakDayStr = "---";
    private double _growthPercent = 0;

    private async Task OnPeriodChanged(int days)
    {
        _selectedDays = days;
        ComputeStats();
        StateHasChanged();
    }

    private string GetDayName(int dayOfWeek) => dayOfWeek switch
    {
        1 => "Thứ 2",
        2 => "Thứ 3",
        3 => "Thứ 4",
        4 => "Thứ 5",
        5 => "Thứ 6",
        6 => "Thứ 7",
        0 => "Chủ Nhật",
        _ => "---"
    };

    // Chart
    private int _chartIndex = -1;
    private ChartOptions _chartOptions = new ChartOptions();
    private List<ChartSeries> _chartSeries = new();
    private string[] _chartLabels = Array.Empty<string>();

    // New Peak Charts
    private List<ChartSeries> _peakHourSeries = new();
    private string[] _peakHourLabels = new string[24];
    private List<ChartSeries> _peakDaySeries = new();
    private string[] _peakDayLabels = new[] { "Hai", "Ba", "Tư", "Năm", "Sáu", "Bảy", "CN" };
    private ChartOptions _peakChartOptions = new ChartOptions { 
        ShowLegend = false, 
        LineStrokeWidth = 4,
        YAxisTicks = 20,
        InterpolationOption = InterpolationOption.NaturalSpline
    };
    private ChartOptions _barChartOptions = new ChartOptions { ShowLegend = false };

    // Device Management
    class DeviceSession
    {
        public string DeviceId { get; set; } = "";
        public DateTime LastActive { get; set; }
        public string LastPoiName { get; set; } = "";
        public int ScanCount { get; set; }
        public bool IsOnline => (DateTime.UtcNow - LastActive).TotalSeconds < 30;
    }
    private List<DeviceSession> _activeDevices = new();
    private string _searchString = "";

    bool _mapsInitialized = false;
    List<LocationTrace> _traces = new();
    List<AnalyticsEvent> _events = new();
    List<AppHistory> _history = new();
    List<PoiModel> _pois = new();
    List<UnifiedEvent> _unified = new();
    bool _loading = true;
    bool _isAdmin = false;

    int _totalPlay, _totalQr, _avgDuration, _uniquePois;
    int _uniqueDevicesCount; // NEW
    double _totalRevenue;
    double _totalMerchantRevenue;
    List<KeyValuePair<string, int>> _topPois = new();
    List<KeyValuePair<string, int>> _langStats = new();

    class RevenueGroup { public string Month { get; set; } = ""; public double Amount { get; set; } public int Count { get; set; } }
    class PoiRevenue { public string Name { get; set; } = ""; public double Amount { get; set; } }
    List<RevenueGroup> _monthlyRevenue = new();
    List<PoiRevenue> _poiRevenue = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAllData();
    }

    async Task LoadAllData(bool force = false)
    {
        _loading = true;
        StateHasChanged();
        try 
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            _isAdmin = user.IsInRole("admin");
            
            var t1 = Api.GetAnalyticsAsync(force);
            var t2 = Api.GetTracesAsync(force);
            var t3 = Api.GetHistoryAsync(force);
            var t4 = Api.GetPoisAsync(force);
            
            await Task.WhenAll(t1, t2, t3, t4);
            
            var allPois = t4.Result ?? new();

            // Filter data based on Role và OwnerId
            if (_isAdmin)
            {
                _pois = allPois;
                _events = t1.Result ?? new();
                _traces = t2.Result ?? new();
                _history = t3.Result ?? new();
            }
            else
            {
                var username = user.Identity?.Name ?? "";
                // Chỉ lấy POI thuộc về mình
                _pois = allPois.Where(p => p.OwnerId == username).ToList();
                var managedIds = _pois.Select(p => p.Id).ToList();

                _events = (t1.Result ?? new()).Where(e => managedIds.Contains(e.PoiId)).ToList();
                _traces = new(); // Owners don't see traces for now
                _history = (t3.Result ?? new()).Where(h => managedIds.Contains(h.PoiId)).ToList();
            }
            
            BuildUnified();
            ComputeStats();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading analytics: {ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    void BuildUnified()
    {
        var list = new List<UnifiedEvent>();

        // 1. Nạp History
        foreach (var h in _history)
        {
            if (!_isAdmin && h.Action == "pay_audio") continue;
            list.Add(new UnifiedEvent
            {
                Timestamp = h.Timestamp,
                EventType = h.Action,
                PoiId = h.PoiId,
                PoiName = string.IsNullOrEmpty(h.PoiName) ? (_pois.FirstOrDefault(p => p.Id == h.PoiId)?.Name ?? "") : h.PoiName,
                Language = h.Language,
                Device = h.Device,
                Duration = h.Duration,
                Lat = h.Lat,
                Lng = h.Lng,
                Amount = h.Amount
            });
        }

        // 2. Nạp Analytics Event (Play Audio, Scan QR, etc.)
        foreach (var e in _events)
        {
            list.Add(new UnifiedEvent
            {
                Timestamp = e.Timestamp,
                EventType = e.EventType, // Sửa: Dùng EventType thực tế thay vì hardcode
                PoiId = e.PoiId,
                PoiName = _pois.FirstOrDefault(p => p.Id == e.PoiId)?.Name ?? e.PoiId,
                Language = e.Language,
                Device = e.DeviceId,
                Duration = e.Duration,
                Lat = e.Lat,
                Lng = e.Lng
            });
        }

        // 3. Nạp Location Traces (GPS)
        foreach (var t in _traces)
        {
            list.Add(new UnifiedEvent
            {
                Timestamp = t.Timestamp,
                EventType = "move_gps",
                Device = t.DeviceId,
                Lat = t.Lat,
                Lng = t.Lng
            });
        }

        _unified = list.OrderByDescending(e => e.Timestamp).ToList();
    }

    void ComputeStats()
    {
        _totalPlay = _unified.Count(e => IsPlayAction(e.EventType));
        _totalQr = _unified.Count(h => IsScanAction(h.EventType));
        
        // --- NEW: Unique Devices ---
        _uniqueDevicesCount = _unified.Where(e => !string.IsNullOrEmpty(e.Device))
                                     .Select(e => e.Device).Distinct().Count();

        _avgDuration = _unified.Any(e => e.Duration > 0)
            ? (int)_unified.Where(e => e.Duration > 0).Average(e => e.Duration) : 0;
            
        _uniquePois = _unified.Where(e => !string.IsNullOrEmpty(e.PoiId))
            .Select(e => e.PoiId).Distinct().Count();

        var payEvents = _unified.Where(e => e.EventType == "pay_audio").ToList();
        var regEvents = _unified.Where(e => e.EventType == "register_poi").ToList();

        _totalRevenue = payEvents.Sum(e => e.Amount);
        _totalMerchantRevenue = regEvents.Sum(e => e.Amount);

        _monthlyRevenue = payEvents.Concat(regEvents).GroupBy(e => e.Timestamp.ToLocalTime().ToString("MM/yyyy"))
            .Select(g => new RevenueGroup { Month = g.Key, Amount = g.Sum(e => e.Amount), Count = g.Count() })
            .OrderByDescending(x => x.Month).ToList();

        _poiRevenue = payEvents.GroupBy(e => string.IsNullOrEmpty(e.PoiName) ? e.PoiId : e.PoiName)
            .Select(g => new PoiRevenue { Name = g.Key, Amount = g.Sum(e => e.Amount) })
            .OrderByDescending(x => x.Amount).ToList();
        
        _topPois = _unified.Where(e => !string.IsNullOrEmpty(e.PoiId) && IsPlayAction(e.EventType))
            .GroupBy(e => string.IsNullOrEmpty(e.PoiName) ? e.PoiId : e.PoiName)
            .OrderByDescending(g => g.Count()).Take(5)
            .Select(g => new KeyValuePair<string, int>(g.Key, g.Count())).ToList();
            
        _langStats = _unified.Where(e => !string.IsNullOrEmpty(e.Language))
            .GroupBy(e => NormalizeLang(e.Language))
            .OrderByDescending(g => g.Count())
            .Select(g => new KeyValuePair<string, int>(g.Key, g.Count())).ToList();

        // --- NEW: Dynamic Filtered Data & Growth ---
        var filterDate = DateTime.UtcNow.AddDays(-_selectedDays);
        var recentData = _unified.Where(e => e.Timestamp >= filterDate).ToList();
        var previousDate = filterDate.AddDays(-_selectedDays);
        var previousCount = _unified.Count(e => e.Timestamp >= previousDate && e.Timestamp < filterDate);
        
        _totalRecentVisitors = recentData.Count;
        if (previousCount > 0)
            _growthPercent = Math.Round((double)(_totalRecentVisitors - previousCount) / previousCount * 100, 1);
        else
            _growthPercent = _totalRecentVisitors > 0 ? 100 : 0;

        // --- NEW: Peak Hour Data ---
        var hourGroups = recentData.GroupBy(e => e.Timestamp.ToLocalTime().Hour)
                                .Select(g => new { Hour = g.Key, Count = g.Count() })
                                .ToList();
        double[] hourPoints = new double[24];
        for (int i = 0; i < 24; i++) 
        {
            _peakHourLabels[i] = i.ToString("D2");
            hourPoints[i] = hourGroups.FirstOrDefault(g => g.Hour == i)?.Count ?? 0;
        }
        _peakHourSeries = new List<ChartSeries> { new ChartSeries { Name = "Lượt khách", Data = hourPoints } };
        
        if (hourGroups.Any())
        {
            var maxHour = hourGroups.OrderByDescending(g => g.Count).First();
            _peakHourStr = $"{maxHour.Hour:D2}:00";
        }

        // --- NEW: Peak Day Data ---
        var dayGroups = recentData.GroupBy(e => (int)e.Timestamp.ToLocalTime().DayOfWeek)
                               .Select(g => new { Day = g.Key, Count = g.Count() })
                               .ToList();
        double[] dayPoints = new double[7];
        int[] dayMap = { 1, 2, 3, 4, 5, 6, 0 }; // Mon=1...Sun=0
        for (int i = 0; i < 7; i++) 
        {
            dayPoints[i] = dayGroups.FirstOrDefault(g => g.Day == dayMap[i])?.Count ?? 0;
        }
        _peakDaySeries = new List<ChartSeries> { new ChartSeries { Name = "Lượt khách", Data = dayPoints } };

        if (dayGroups.Any())
        {
            var maxDay = dayGroups.OrderByDescending(g => g.Count).First();
            _peakDayStr = GetDayName(maxDay.Day);
        }

        // --- NEW: Active Device Sessions (Including Virtual Machines for Testing) ---
        _activeDevices = _unified
            .Where(e => !string.IsNullOrEmpty(e.Device))
            .GroupBy(e => e.Device)
            .Select(g => {
                var latest = g.OrderByDescending(x => x.Timestamp).First();
                return new DeviceSession {
                    DeviceId = g.Key,
                    LastActive = latest.Timestamp,
                    LastPoiName = latest.PoiName,
                    ScanCount = g.Count(x => IsScanAction(x.EventType))
                };
            })
            // Hiển thị TẤT CẢ thiết bị có tương tác (để dễ dàng test cả máy ảo và máy thật)
            .Where(x => true) 
            .OrderByDescending(x => x.LastActive)
            .ToList();

        PrepareChartData();
    }

    private bool FilterFunc(DeviceSession device)
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        if (device.DeviceId.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (device.LastPoiName.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    }

    bool IsPlayAction(string action) => 
        string.Equals(action, "poi_play", StringComparison.OrdinalIgnoreCase) || 
        string.Equals(action, "play_poi", StringComparison.OrdinalIgnoreCase) || 
        string.Equals(action, "listen_poi", StringComparison.OrdinalIgnoreCase);

    bool IsScanAction(string action) => 
        string.Equals(action, "scan_qr", StringComparison.OrdinalIgnoreCase);

    Color GetActionColor(string action) => action.ToLower() switch
    {
        "scan_qr" => Color.Success,
        "poi_play" or "play_poi" or "listen_poi" => Color.Primary,
        "route_start" => Color.Warning,
        "language_change" => Color.Secondary,
        _ => Color.Default
    };

    void PrepareChartData()
    {
        var localNow = DateTime.Now.Date;
        var startDate = localNow.AddDays(-6);
        var labels = new List<string>();
        var revenueData = new List<double>();
        var countData = new List<double>();

        for (int i = 6; i >= 0; i--)
        {
            var date = localNow.AddDays(-i);
            labels.Add(date.ToString("dd/MM"));

            var dayPays = _unified.Where(e => e.Timestamp.ToLocalTime().Date == date && e.EventType == "pay_audio");
            
            revenueData.Add(dayPays.Sum(e => e.Amount));
            countData.Add(dayPays.Count());
        }

        _chartLabels = labels.ToArray();
        _chartSeries = new List<ChartSeries>()
        {
            new ChartSeries() { Name = "Doanh thu (VND)", Data = revenueData.ToArray() },
            new ChartSeries() { Name = "Lượt thanh toán", Data = countData.ToArray() }
        };
        
        _chartOptions.ShowLegend = true;
    }

    async Task ExportToExcel()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Thoi gian,Hanh dong,POI,So tien (VND),Thiet bi,Ngon ngu");
        
        foreach (var e in _unified.Where(e => e.EventType == "pay_audio").OrderByDescending(x => x.Timestamp))
        {
            sb.AppendLine($"{e.Timestamp.ToLocalTime():dd/MM/yyyy HH:mm},{e.EventType},{e.PoiName},{e.Amount},{e.Device},{e.Language}");
        }

        var csv = sb.ToString();
        var fileName = $"DoanhThu_VinhKhanh_{DateTime.Now:ddMMyyyy}.csv";
        
        // Use the existing utility or add a new one
        await JS.InvokeVoidAsync("downloadFileFromBlob", fileName, csv, "text/csv;charset=utf-8;");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loading || _mapsInitialized) return;
        _mapsInitialized = true;
        await Task.Delay(500);
        try
        {
            
            // Chuẩn bị dữ liệu Trace có lọc theo thời gian và tách lộ trình
            var filterDate = DateTime.UtcNow.AddDays(-_selectedDays);
            var filteredTraces = _traces.Where(t => t.Timestamp >= filterDate).ToList();
            
            var routesForJs = new List<object>();
            var groupedTraces = filteredTraces.GroupBy(t => t.DeviceId);

            foreach (var group in groupedTraces)
            {
                var sortedPoints = group.OrderBy(t => t.Timestamp).ToList();
                if (!sortedPoints.Any()) continue;

                var currentRoutePoints = new List<object>();
                
                for (int i = 0; i < sortedPoints.Count; i++)
                {
                    var p = sortedPoints[i];
                    
                    // Nếu khoảng cách giữa 2 điểm > 1 giờ, tách thành route mới
                    if (i > 0 && (p.Timestamp - sortedPoints[i-1].Timestamp).TotalHours > 1)
                    {
                        if (currentRoutePoints.Any())
                        {
                            routesForJs.Add(new { id = group.Key, points = currentRoutePoints });
                        }
                        currentRoutePoints = new List<object>();
                    }
                    
                    currentRoutePoints.Add(new { lat = p.Lat, lng = p.Lng, time = p.Timestamp });
                }

                if (currentRoutePoints.Any())
                {
                    routesForJs.Add(new { id = group.Key, points = currentRoutePoints });
                }
            }

            await JS.InvokeVoidAsync("initTraceMap", routesForJs);

            // --- NEW: POI Hotspot Heatmap ---
            var poiHotspots = _unified.Where(e => !string.IsNullOrEmpty(e.PoiId))
                                     .GroupBy(e => e.PoiId)
                                     .Select(g => {
                                         var poi = _pois.FirstOrDefault(p => p.Id == g.Key);
                                         return new {
                                             lat = poi?.Latitude ?? 0,
                                             lng = poi?.Longitude ?? 0,
                                             name = poi?.Name ?? g.Key,
                                             count = g.Count()
                                         };
                                     })
                                     .Where(x => x.lat != 0)
                                     .ToList();
            
            if (poiHotspots.Any())
            {
                var maxCount = poiHotspots.Max(x => x.count);
                var mapData = poiHotspots.Select(x => new {
                    x.lat, x.lng, x.name, x.count,
                    weight = (double)x.count / maxCount // Trọng số từ 0.0 - 1.0
                }).ToList();
                await JS.InvokeVoidAsync("initPoiHeatmap", mapData);
            }
        }
        catch (Exception ex) { Console.WriteLine($"Map error: {ex.Message}"); }
    }

    double GetPercent(int val) => _unified.Count == 0 ? 0 : (double)val / _unified.Count * 100;

    string NormalizeLang(string lang) => lang.ToLowerInvariant().Trim() switch
    {
        "vi" or "vietnamese" or "vn" => "vi",
        "en" or "english" or "gb" => "en",
        "zh" or "chinese" or "cn" => "zh",
        "ja" or "japanese" or "jp" => "ja",
        "ko" or "korean" or "kr" => "ko",
        _ => lang.ToLowerInvariant().Trim()
    };

    string GetLangFlag(string lang) => lang.ToLowerInvariant() switch
    {
        "vi" or "vn" or "vietnamese" => "🇻🇳 Tiếng Việt",
        "en" or "english" or "gb" => "🇬🇧 English",
        "zh" or "chinese" or "cn" => "🇨🇳 中文",
        "ja" or "japanese" or "jp" => "🇯🇵 日本語",
        "ko" or "korean" or "kr" => "🇰🇷 한국어",
        _ => lang.ToUpperInvariant()
    };
}

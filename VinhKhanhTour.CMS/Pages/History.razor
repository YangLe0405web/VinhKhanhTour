@page "/history"
@attribute [Authorize]
@inject CmsApiService Api
@inject AuthenticationStateProvider AuthStateProvider
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject NavigationManager Nav

<MudText Typo="Typo.h4" Class="mb-4">📋 Lịch sử ứng dụng</MudText>

<MudPaper Class="pa-3 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" sm="3">
            <MudText Typo="Typo.caption" Class="ml-1 mb-1" Style="color:rgba(255,255,255,0.5)">Hành động</MudText>
            <MudSelect T="string" Value="_filterAction" ValueChanged="@(v => { _filterAction = v; RefreshFilter(); })"
                       Placeholder="Chọn hành động"
                       Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("")">Tất cả</MudSelectItem>
                <MudSelectItem Value="@("play_poi")">🔊 Nghe POI</MudSelectItem>
                <MudSelectItem Value="@("play_audio")">🔊 Nghe Audio (Web)</MudSelectItem>
                <MudSelectItem Value="@("scan_qr")">📷 Quét QR</MudSelectItem>
                <MudSelectItem Value="@("log_visit")">👤 Khách vào App</MudSelectItem>
                <MudSelectItem Value="@("route_start")">🗺️ Chỉ đường</MudSelectItem>
                @if (_isAdmin)
                {
                    <MudSelectItem Value="@("pay_audio")">💰 Thanh toán</MudSelectItem>
                    <MudSelectItem Value="@("register_poi")">📝 Đăng ký POI</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudText Typo="Typo.caption" Class="ml-1 mb-1" Style="color:rgba(0,0,0,0.5)">Ngôn ngữ</MudText>
            <MudSelect T="string" Value="_filterLang" ValueChanged="@(v => { _filterLang = v; RefreshFilter(); })"
                       Placeholder="Chọn ngôn ngữ"
                       Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("")">Tất cả</MudSelectItem>
                <MudSelectItem Value="@("vi")">🇻🇳 Tiếng Việt</MudSelectItem>
                <MudSelectItem Value="@("en")">🇬🇧 English</MudSelectItem>
                <MudSelectItem Value="@("zh")">🇨🇳 中文</MudSelectItem>
                <MudSelectItem Value="@("ja")">🇯🇵 日本語</MudSelectItem>
                <MudSelectItem Value="@("ko")">🇰🇷 한국어</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudText Typo="Typo.caption" Class="ml-1 mb-1" Style="color:rgba(255,255,255,0.5)">Thời gian</MudText>
            <MudDatePicker Date="_filterDate" DateChanged="@(v => { _filterDate = v; RefreshFilter(); })" 
                            Editable="true" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                            DateFormat="dd/MM/yyyy" Placeholder="Chọn ngày..." />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudText Typo="Typo.caption" Class="ml-1 mb-1" Style="color:rgba(255,255,255,0.5)">ID Thiết bị</MudText>
            <MudTextField T="string" Value="_filterDevice" ValueChanged="@(v => { _filterDevice = v; RefreshFilter(); })" Placeholder="ID..." 
                          Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="3" Class="d-flex flex-column justify-end">
            <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                        OnClick="@(() => LoadData(true))" StartIcon="@Icons.Material.Filled.Refresh" 
                        Disabled="_loading" Style="height:40px; text-transform:none;">
                @(_loading ? "Đang tải..." : "TẢI LẠI (SMART CACHE)")
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudTable Items="FilteredHistory" Hover="true" Striped="true" FixedHeader="true" Height="650px"
              Virtualize="true" HorizontalScrollbar="true" Breakpoint="Breakpoint.None">
        <HeaderContent>
            <MudTh Style="min-width:140px">Thời gian</MudTh>
            <MudTh Style="min-width:160px">Hành động</MudTh>
            <MudTh Style="min-width:180px">Chi tiết / Địa điểm</MudTh>
            <MudTh Style="min-width:140px">Thiết bị</MudTh>
            <MudTh Style="min-width:100px">Ngôn ngữ</MudTh>
            <MudTh Style="min-width:100px">Số tiền</MudTh>
            <MudTh Style="min-width:100px">Thời lượng</MudTh>
            <MudTh Style="min-width:120px">Vị trí (GPS)</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <MudText Typo="Typo.body2" Style="font-weight: 500;">
                    @context.Timestamp.ToLocalTime().ToString("HH:mm:ss")
                </MudText>
                <MudText Typo="Typo.caption" Style="color:gray">
                    @context.Timestamp.ToLocalTime().ToString("dd/MM/yyyy")
                </MudText>
            </MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small"
                         Color="context.Color" Variant="Variant.Filled">
                    @context.ActionLabel
                </MudChip>
            </MudTd>
            <MudTd>
                @if (!string.IsNullOrEmpty(context.PoiName))
                {
                    <MudText Typo="Typo.body2" Style="font-weight: bold;">@context.PoiName</MudText>
                    <MudText Typo="Typo.caption">@context.PoiId</MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Hành động hệ thống / Di chuyển</MudText>
                }
            </MudTd>
            <MudTd>
                <MudText Typo="Typo.body2" Style="font-family: monospace;">@context.Device</MudText>
            </MudTd>
            <MudTd>@GetLangFlag(context.Language)</MudTd>
            <MudTd>
                @if (context.Amount > 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Success" Style="font-weight:bold">
                        @context.Amount.ToString("N0") VND
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Default">--</MudText>
                }
            </MudTd>
            <MudTd>
                @if (context.Duration > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                        @(context.Duration) s
                    </MudChip>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Default">--</MudText>
                }
            </MudTd>
            <MudTd>
                @if (context.Lat != 0 && context.Lng != 0)
                {
                    <MudLink href="@($"https://www.google.com/maps?q={context.Lat},{context.Lng}")" Target="_blank" Style="text-decoration:none">
                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Color="Color.Error" />
                        <MudText Typo="Typo.caption">@($"{context.Lat:F4},{context.Lng:F4}")</MudText>
                    </MudLink>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Default">--</MudText>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-4">Chưa có dữ liệu lịch sử</MudText>
        </NoRecordsContent>
    </MudTable>

    <MudText Typo="Typo.caption" Class="mt-2">
        Tổng: @FilteredHistory.Count() bản ghi
    </MudText>
}

@code {
    class UnifiedHistory
    {
        public DateTime Timestamp { get; set; }
        public string Action { get; set; } = "";
        public string ActionLabel { get; set; } = "";
        public Color Color { get; set; } = Color.Default;
        public string PoiId { get; set; } = "";
        public string PoiName { get; set; } = "";
        public string Device { get; set; } = "";
        public string Language { get; set; } = "";
        public double Amount { get; set; }
        public int Duration { get; set; }
        public double Lat { get; set; }
        public double Lng { get; set; }
    }

    List<UnifiedHistory> _history = new();
    bool _loading = true;
    string _filterAction = "";
    string _filterLang = "";
    string _filterDevice = "";
    DateTime? _filterDate;
    bool _isAdmin = false;
  
    IList<UnifiedHistory> FilteredHistory => _filteredCache;
    List<UnifiedHistory> _filteredCache = new();

    void RefreshFilter()
    {
        _filteredCache = _history
            .Where(h => string.IsNullOrEmpty(_filterAction) || h.Action == _filterAction)
            .Where(h => string.IsNullOrEmpty(_filterLang) || h.Language == _filterLang)
            .Where(h => string.IsNullOrEmpty(_filterDevice) || (h.Device != null && h.Device.Contains(_filterDevice, StringComparison.OrdinalIgnoreCase)))
            .Where(h => !_filterDate.HasValue || h.Timestamp.ToLocalTime().Date == _filterDate.Value.Date)
            .Take(500)
            .ToList();
    }

    protected override async Task OnInitializedAsync() 
    {
        // Parse device query string if exists manually for Blazor WASM
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = uri.Query;
        if (!string.IsNullOrEmpty(query) && query.Contains("device="))
        {
            var parts = query.Split(new[] { "device=" }, StringSplitOptions.None);
            if (parts.Length > 1)
            {
                var val = parts[1].Split('&')[0];
                _filterDevice = Uri.UnescapeDataString(val);
            }
        }

        await LoadData();
    }

    async Task LoadData(bool force = false)
    {
        _loading = true;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _isAdmin = user.IsInRole("admin");
        
        var username = user.Identity?.Name ?? "";
        
        // Load API concurrently
        var logTask = Api.GetHistoryAsync(force);
        var analyticTask = Api.GetAnalyticsAsync(force);
        var traceTask = Api.GetTracesAsync(force);
        var poiTask = Api.GetPoisAsync(force);

        await Task.WhenAll(logTask, analyticTask, traceTask, poiTask);

        var logs = await logTask ?? new();
        var events = await analyticTask ?? new();
        var traces = await traceTask ?? new();
        var pois = await poiTask ?? new();

        var myPoiIds = _isAdmin ? new List<string>() : pois.Where(p => p.OwnerId == username).Select(p => p.Id).ToList();

        // 1. Convert Logs
        var unifiedLogs = logs.Select(h => new UnifiedHistory {
            Timestamp = h.Timestamp,
            Action = h.Action,
            ActionLabel = GetActionLabel(h.Action),
            Color = GetActionColor(h.Action),
            PoiId = h.PoiId,
            PoiName = h.PoiName,
            Device = h.Device,
            Language = h.Language,
            Amount = h.Amount,
            Duration = h.Duration,
            Lat = h.Lat,
            Lng = h.Lng
        });

        // 2. Convert Analytics (Audio)
        var unifiedEvents = events.Select(e => new UnifiedHistory {
            Timestamp = e.Timestamp,
            Action = "play_poi",
            ActionLabel = "🔊 Nghe Audio",
            Color = Color.Success,
            PoiId = e.PoiId,
            PoiName = pois.FirstOrDefault(p => p.Id == e.PoiId)?.Name ?? e.PoiId,
            Device = e.DeviceId,
            Language = e.Language,
            Duration = e.Duration,
            Lat = e.Lat,
            Lng = e.Lng
        });

        // KHÔNG nạp traces vào lịch sử (quá nhiều record GPS gây lag)
        // Traces chỉ dùng cho heatmap ở Dashboard

        _history = unifiedLogs.Concat(unifiedEvents)
            .OrderByDescending(x => x.Timestamp)
            .ToList();

        if (!_isAdmin)
        {
            _history = _history.Where(h => h.Action != "pay_audio" && (string.IsNullOrEmpty(h.PoiId) || myPoiIds.Contains(h.PoiId))).ToList();
        }

        RefreshFilter();
        _loading = false;
    }

    string GetActionLabel(string action) => action switch
    {
        "open_app" => "📱 Mở app",
        "log_visit" => "👤 Khách Online",
        "play_poi" => "🔊 Nghe Audio",
        "play_audio" => "🔊 Nghe Audio",
        "play_audio_end" => "✅ Nghe xong",
        "listen_poi" => "🔊 Nghe Audio",
        "scan_qr" => "📷 Quét QR",
        "route_start" => "🗺️ Chỉ đường",
        "language_change" => "🌐 Đổi ngôn ngữ",
        "pay_audio" => "💰 Thanh toán",
        "register_poi" => "📝 Đăng ký POI",
        "merchant_register" => "👤 Đăng ký Chủ quán",
        _ => action
    };

    Color GetActionColor(string action) => action switch
    {
        "open_app" => Color.Info,
        "log_visit" => Color.Info,
        "play_poi" => Color.Success,
        "play_audio" => Color.Success,
        "play_audio_end" => Color.Default,
        "listen_poi" => Color.Success,
        "scan_qr" => Color.Warning,
        "route_start" => Color.Primary,
        "language_change" => Color.Secondary,
        "pay_audio" => Color.Success,
        "register_poi" => Color.Info,
        "merchant_register" => Color.Info,
        _ => Color.Default
    };

    string GetLangFlag(string lang) => lang switch
    {
        "vi" => "🇻🇳 VI",
        "en" => "🇬🇧 EN",
        "zh" => "🇨🇳 ZH",
        "ja" => "🇯🇵 JA",
        "ko" => "🇰🇷 KO",
        _ => string.IsNullOrEmpty(lang) ? "--" : lang
    };
}